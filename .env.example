# ABBI DeskLive — Environment Variables

# ─── API MODE ──────────────────────────────────────────────
VITE_API_MODE=mock

# ─── INDODAX API CREDENTIALS (Backend Only) ───────────────
# JANGAN pakai prefix VITE_ — secret ini hanya untuk backend
INDODAX_API_KEY=your_indodax_api_key_here
INDODAX_API_SECRET=your_indodax_api_secret_here

# ─── WEBSOCKET TOKEN ───────────────────────────────────────
VITE_INDODAX_WS_TOKEN=your_indodax_ws_token_here

# ─── BACKEND AUTH ──────────────────────────────────────────
API_AUTH_KEY=generate_a_strong_random_key_min_32_chars

# ─── CORS ──────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ─── BACKEND PORT ──────────────────────────────────────────
PORT=3002
EOFcd ~/abbi-desklive
cat > .env.example << 'EOF'
